{
    "name": "UmamiAnalytics",
    "version": "0.1.0",
    "author": [
        "[https://www.mediawiki.org/wiki/User:Linedwell Linedwell]"
    ],
    "url": "https://www.mediawiki.org/wiki/Extension:UmamiAnalytics",
    "descriptionmsg": "umamianalytics-desc",
    "license-name": "GPL-3.0-or-later",
    "type": "other",
    "requires": {
        "MediaWiki": ">= 1.43"
    },
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\UmamiAnalytics\\": "includes/"
    },
    "HookHandlers": {
        "main": {
            "class": "MediaWiki\\Extension\\UmamiAnalytics\\Hooks",
            "services": [
                "PageProps"
            ]
        }
    },
    "Hooks": {
        "BeforePageDisplay": "main"
    },
    "ResourceModules": {
        "ext.umamiAnalytics": {
            "scripts": [
                "ext.umamiAnalytics.js"
            ],
            "localBasePath": "resources",
            "remoteExtPath": "UmamiAnalytics/resources"
        }
    },
    "config": {
        "UmamiAnalyticsScriptUrl": {
            "value": null
        },
        "UmamiAnalyticsHostUrl": {
            "value": null
        },
        "UmamiAnalyticsWebsiteId": {
            "value": null
        },
        "UmamiAnalyticsNamespaces": {
            "value": [
                0
            ]
        },
        "UmamiAnalyticsExcludeOldRevisions": {
            "value": true
        },
        "UmamiAnalyticsExcludeDiffs": {
            "value": true
        },
        "UmamiAnalyticsRespectDNT": {
            "value": true
        }
    },
    "MessagesDirs": {
        "UmamiAnalytics": [
            "i18n"
        ]
    },
    "manifest_version": 2
}